        "formulaJson": "{\"template\":\"(servers × costPerServer) − cloudSpend\",\"tokens\":[{\"id\":\"servers\",\"kind\":\"input\"},{\"id\":\"costPerServer\",\"kind\":\"input\"},{\"id\":\"cloudSpend\",\"kind\":\"input\"}]}",
