        "resultJson": "{\"value\":1656000,\"unit\":\"USD/yr\",\"label\":\"Annual ROI\"}",
        "stepsJson": "[{\"description\":\"Monthly user-hours recovered\",\"value\":42000},{\"description\":\"Annual savings at $45/hr\",\"value\":22680000},{\"description\":\"Minus license cost\",\"value\":-264000},{\"description\":\"Net annual benefit\",\"value\":1656000}]",
