        "secondarySidebarBodyHtml": "",
        "tabListHtml": "<div class=\"vs-tab vs-tab--active\"><span class=\"vs-tab-icon\"><svg width=\"16\" height=\"16\" aria-hidden=\"true\"><use href=\"#vscode-icon-file-ts\"/></svg></span><span class=\"vs-tab-label\">auth.ts</span><span class=\"vs-tab-dirty\"></span></div><div class=\"vs-tab\"><span class=\"vs-tab-icon\"><svg width=\"16\" height=\"16\" aria-hidden=\"true\"><use href=\"#vscode-icon-file-ts\"/></svg></span><span class=\"vs-tab-label\">login.ts</span><button class=\"vs-tab-close\" aria-label=\"Close\"><svg width=\"16\" height=\"16\" aria-hidden=\"true\"><use href=\"#vscode-icon-close\"/></svg></button></div>",
        "breadcrumbHtml": "<span class=\"vs-bc-item\"><span style=\"display:inline-flex;width:14px;height:14px\"><svg width=\"16\" height=\"16\" aria-hidden=\"true\"><use href=\"#vscode-icon-folder\"/></svg></span><span>contoso-app</span></span><span class=\"vs-bc-sep\"><svg width=\"16\" height=\"16\" aria-hidden=\"true\"><use href=\"#vscode-icon-chevron-right\"/></svg></span><span class=\"vs-bc-item\"><span style=\"display:inline-flex;width:14px;height:14px\"><svg width=\"16\" height=\"16\" aria-hidden=\"true\"><use href=\"#vscode-icon-folder\"/></svg></span><span>src</span></span><span class=\"vs-bc-sep\"><svg width=\"16\" height=\"16\" aria-hidden=\"true\"><use href=\"#vscode-icon-chevron-right\"/></svg></span><span class=\"vs-bc-item\"><span style=\"display:inline-flex;width:14px;height:14px\"><svg width=\"16\" height=\"16\" aria-hidden=\"true\"><use href=\"#vscode-icon-folder\"/></svg></span><span>auth</span></span><span class=\"vs-bc-sep\"><svg width=\"16\" height=\"16\" aria-hidden=\"true\"><use href=\"#vscode-icon-chevron-right\"/></svg></span><span class=\"vs-bc-item\"><span style=\"display:inline-flex;width:14px;height:14px\"><svg width=\"16\" height=\"16\" aria-hidden=\"true\"><use href=\"#vscode-icon-file-ts\"/></svg></span><span>auth.ts</span></span>",
        "gutterHtml": "<span class=\"vs-gutter-line\">1</span><span class=\"vs-gutter-line\">2</span><span class=\"vs-gutter-line\">3</span><span class=\"vs-gutter-line\">4</span><span class=\"vs-gutter-line\">5</span><span class=\"vs-gutter-line\">6</span><span class=\"vs-gutter-line\">7</span><span class=\"vs-gutter-line\">8</span><span class=\"vs-gutter-line\">9</span><span class=\"vs-gutter-line\">10</span><span class=\"vs-gutter-line\">11</span><span class=\"vs-gutter-line\">12</span><span class=\"vs-gutter-line\">13</span><span class=\"vs-gutter-line\">14</span><span class=\"vs-gutter-line\">15</span><span class=\"vs-gutter-line\">16</span><span class=\"vs-gutter-line\">17</span><span class=\"vs-gutter-line\">18</span><span class=\"vs-gutter-line\">19</span><span class=\"vs-gutter-line\">20</span><span class=\"vs-gutter-line\">21</span><span class=\"vs-gutter-line\">22</span><span class=\"vs-gutter-line\">23</span>",
        "codeContentHtml": "<span class=\"vs-code-line\"><span class=\"vs-tk-com\">// Authentication service</span></span><span class=\"vs-code-line\"><span class=\"vs-tk-kw\">import</span> { <span class=\"vs-tk-var\">sign</span>, <span class=\"vs-tk-var\">verify</span> } <span class=\"vs-tk-kw\">from</span> <span class=\"vs-tk-str\">'jsonwebtoken'</span>;</span><span class=\"vs-code-line\"><span class=\"vs-tk-kw\">import</span> { <span class=\"vs-tk-var\">hash</span>, <span class=\"vs-tk-var\">compare</span> } <span class=\"vs-tk-kw\">from</span> <span class=\"vs-tk-str\">'bcrypt'</span>;</span><span class=\"vs-code-line\"></span><span class=\"vs-code-line\"><span class=\"vs-tk-kw\">export</span> <span class=\"vs-tk-kw\">class</span> <span class=\"vs-tk-type\">AuthService</span> {</span><span class=\"vs-code-line\">  <span class=\"vs-tk-kw\">private</span> <span class=\"vs-tk-var\">secret</span>: <span class=\"vs-tk-type\">string</span>;</span><span class=\"vs-code-line\"></span><span class=\"vs-code-line\">  <span class=\"vs-tk-kw\">constructor</span>(<span class=\"vs-tk-var\">secret</span>: <span class=\"vs-tk-type\">string</span>) {</span><span class=\"vs-code-line\">    <span class=\"vs-tk-kw\">this</span>.<span class=\"vs-tk-prop\">secret</span> = <span class=\"vs-tk-var\">secret</span>;</span><span class=\"vs-code-line\">  }</span><span class=\"vs-code-line\"></span><span class=\"vs-code-line\">  <span class=\"vs-tk-kw\">async</span> <span class=\"vs-tk-fn\">login</span>(<span class=\"vs-tk-var\">email</span>: <span class=\"vs-tk-type\">string</span>, <span class=\"vs-tk-var\">password</span>: <span class=\"vs-tk-type\">string</span>) {</span><span class=\"vs-code-line\">    <span class=\"vs-tk-kw\">const</span> <span class=\"vs-tk-var\">user</span> = <span class=\"vs-tk-kw\">await</span> <span class=\"vs-tk-fn\">findUser</span>(<span class=\"vs-tk-var\">email</span>);</span><span class=\"vs-code-line\">    <span class=\"vs-tk-kw\">if</span> (!<span class=\"vs-tk-var\">user</span>) <span class=\"vs-tk-kw\">return</span> <span class=\"vs-tk-kw\">null</span>;</span><span class=\"vs-code-line\">    <span class=\"vs-tk-kw\">const</span> <span class=\"vs-tk-var\">ok</span> = <span class=\"vs-tk-kw\">await</span> <span class=\"vs-tk-fn\">compare</span>(<span class=\"vs-tk-var\">password</span>, <span class=\"vs-tk-var\">user</span>.<span class=\"vs-tk-prop\">hash</span>);</span><span class=\"vs-code-line\">    <span class=\"vs-tk-kw\">if</span> (!<span class=\"vs-tk-var\">ok</span>) <span class=\"vs-tk-kw\">return</span> <span class=\"vs-tk-kw\">null</span>;</span><span class=\"vs-code-line\">    <span class=\"vs-tk-kw\">return</span> <span class=\"vs-tk-fn\">sign</span>({ <span class=\"vs-tk-prop\">sub</span>: <span class=\"vs-tk-var\">user</span>.<span class=\"vs-tk-prop\">id</span> }, <span class=\"vs-tk-kw\">this</span>.<span class=\"vs-tk-prop\">secret</span>);</span><span class=\"vs-code-line\">  }</span><span class=\"vs-code-line\"></span><span class=\"vs-code-line\">  <span class=\"vs-tk-fn\">verify</span>(<span class=\"vs-tk-var\">token</span>: <span class=\"vs-tk-type\">string</span>) {</span><span class=\"vs-code-line\">    <span class=\"vs-tk-kw\">return</span> <span class=\"vs-tk-fn\">verify</span>(<span class=\"vs-tk-var\">token</span>, <span class=\"vs-tk-kw\">this</span>.<span class=\"vs-tk-prop\">secret</span>);</span><span class=\"vs-code-line\">  }</span><span class=\"vs-code-line\">}</span>",
        "minimapHtml": "<div class=\"vs-minimap-row is-kw\"></div><div class=\"vs-minimap-row is-com\"></div><div class=\"vs-minimap-row is-kw\"></div><div class=\"vs-minimap-row is-empty\"></div><div class=\"vs-minimap-row is-kw\"></div><div class=\"vs-minimap-row is-var\"></div><div class=\"vs-minimap-row is-empty\"></div><div class=\"vs-minimap-row is-kw\"></div><div class=\"vs-minimap-row is-prop\"></div><div class=\"vs-minimap-row is-empty\"></div><div class=\"vs-minimap-row is-kw\"></div><div class=\"vs-minimap-row is-var\"></div><div class=\"vs-minimap-row is-var\"></div><div class=\"vs-minimap-row is-var\"></div><div class=\"vs-minimap-row is-var\"></div><div class=\"vs-minimap-row is-var\"></div><div class=\"vs-minimap-row is-kw\"></div><div class=\"vs-minimap-row is-empty\"></div><div class=\"vs-minimap-row is-kw\"></div><div class=\"vs-minimap-row is-kw\"></div><div class=\"vs-minimap-row is-empty\"></div><div class=\"vs-minimap-row is-kw\"></div>",
