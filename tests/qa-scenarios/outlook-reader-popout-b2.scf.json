        "viewBodyHtml": "<style>\n.b2-popout-root{position:fixed;inset:0;z-index:9999;background:#faf9f8;display:flex;flex-direction:column;font-family:'Segoe UI Variable','Segoe UI',system-ui,Arial,sans-serif;color:#201f1e;overflow:hidden}\n.b2-titlebar{display:flex;align-items:center;height:40px;flex:0 0 40px;padding:0 4px 0 12px;background:#ffffff;border-bottom:1px solid #e1dfdd;gap:10px}\n.b2-tb-logo{width:20px;height:20px;flex:0 0 20px}\n.b2-tb-title{flex:1 1 auto;min-width:0;font-size:13px;color:#201f1e;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-weight:400}\n.b2-tb-controls{display:flex;align-items:center}\n.b2-tb-btn{width:46px;height:40px;display:inline-flex;align-items:center;justify-content:center;background:transparent;border:0;cursor:pointer;color:#605e5c}\n.b2-tb-btn svg{width:12px;height:12px}\n.b2-tb-btn.b2-close{color:#201f1e}\n.b2-toolbar{display:flex;align-items:center;height:54px;flex:0 0 54px;padding:0 12px;background:#faf9f8;border-bottom:1px solid #e1dfdd;gap:0}\n.b2-tool{display:inline-flex;flex-direction:column;align-items:center;justify-content:center;height:50px;min-width:60px;padding:0 8px;background:transparent;border:0;cursor:pointer;color:#201f1e;gap:3px;border-radius:4px}\n.b2-tool:hover{background:#f3f2f1}\n.b2-tool svg{width:18px;height:18px;color:#5b5fc7}\n.b2-tool .b2-tool-label{font-size:11px;color:#201f1e;line-height:1;white-space:nowrap}\n.b2-tool-sep{width:1px;height:32px;background:#e1dfdd;margin:0 6px}\n.b2-tool-spacer{flex:1 1 auto}\n.b2-reader{flex:1 1 auto;min-height:0;overflow:auto;background:#ffffff;padding:24px 64px}\n.b2-reader-inner{max-width:980px;margin:0 auto}\n.b2-summary-row{display:flex;align-items:center;gap:10px;margin-bottom:18px;font-size:13px;color:#5b5fc7}\n.b2-summary-icon{width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center}\n.b2-summary-icon svg{width:18px;height:18px}\n.b2-sender-card{display:flex;align-items:flex-start;gap:14px;padding:14px 0 18px 0;border-bottom:1px solid #f3f2f1;margin-bottom:18px}\n.b2-avatar{width:48px;height:48px;flex:0 0 48px;border-radius:50%;background:linear-gradient(135deg,#5b5fc7,#7b83eb);color:#ffffff;display:inline-flex;align-items:center;justify-content:center;font-size:17px;font-weight:600;letter-spacing:.3px}\n.b2-sender-meta{flex:1 1 auto;min-width:0}\n.b2-sender-line1{display:flex;align-items:baseline;gap:8px;flex-wrap:wrap}\n.b2-sender-name{font-size:14px;font-weight:600;color:#201f1e}\n.b2-sender-email{font-size:13px;color:#605e5c}\n.b2-recipients-line{display:flex;align-items:center;gap:6px;margin-top:4px;font-size:13px;color:#605e5c;flex-wrap:wrap}\n.b2-recipients-label{color:#605e5c}\n.b2-recipient{color:#0078d4}\n.b2-recipients-more{display:inline-flex;align-items:center;height:20px;padding:0 8px;background:#f3f2f1;border-radius:10px;font-size:12px;color:#605e5c;margin-left:2px}\n.b2-sender-actions{display:flex;align-items:center;gap:4px;flex:0 0 auto}\n.b2-sender-time{font-size:12px;color:#605e5c;margin-right:8px;white-space:nowrap}\n.b2-icon-btn{width:32px;height:32px;display:inline-flex;align-items:center;justify-content:center;background:transparent;border:0;border-radius:4px;cursor:pointer;color:#605e5c}\n.b2-icon-btn:hover{background:#f3f2f1}\n.b2-icon-btn svg{width:16px;height:16px}\n.b2-mini-action{display:inline-flex;align-items:center;gap:5px;height:28px;padding:0 10px;background:transparent;border:0;border-radius:4px;cursor:pointer;color:#201f1e;font-size:12px}\n.b2-mini-action:hover{background:#f3f2f1}\n.b2-mini-action svg{width:14px;height:14px;color:#5b5fc7}\n.b2-subject-h1{font-size:24px;font-weight:600;color:#201f1e;margin:6px 0 18px 0;line-height:1.25}\n.b2-body{font-size:14px;line-height:1.55;color:#201f1e}\n.b2-body p{margin:0 0 12px 0}\n.b2-body ol{margin:6px 0 14px 22px;padding:0}\n.b2-body ol li{margin-bottom:6px}\n.b2-body .b2-sig{margin-top:14px;color:#201f1e}\n.b2-quoted{margin-top:24px;padding-top:14px;border-top:1px solid #e1dfdd;font-size:13px