{
  "$schema": "../../schemas/scf-v1.0.schema.json",
  "version": "1.0",
  "pipeline": "animated-explainer",
  "outputProfile": { "width": 1920, "height": 1080, "fps": 30 },
  "scenes": [
    {
      "id": "planner-charts-10s",
      "duration": 10,
      "component": "PlannerScene",
      "props": {
        "variant": "charts",
        "state": "default",
        "planName": "Livesite – Radar Controls",
        "breadcrumb": "My plans",
        "activeTab": "Charts",
        "groupBy": "Bucket",
        "accountInitial": "A",
        "chartCards": [
          {
            "title": "Tasks left",
            "type": "donut",
            "value": 24,
            "label": "Total tasks",
            "legend": [
              { "label": "Not started", "value": "9",  "color": "#A6A6A6" },
              { "label": "In progress", "value": "8",  "color": "#5B5FC7" },
              { "label": "Late",        "value": "3",  "color": "#D13438" },
              { "label": "Completed",   "value": "4",  "color": "#3FB984" }
            ]
          },
          {
            "title": "Status by priority",
            "type": "bar",
            "bars": [
              { "label": "Urgent",    "value": 4, "segments": [{ "name": "Not Started", "value": 2 }, { "name": "In progress", "value": 1 }, { "name": "Late", "value": 1 }] },
              { "label": "Important", "value": 8, "segments": [{ "name": "Not Started", "value": 3 }, { "name": "In progress", "value": 4 }, { "name": "Late", "value": 1 }] },
              { "label": "Medium",    "value": 4, "segments": [{ "name": "Not Started", "value": 2 }, { "name": "In progress", "value": 2 }] },
              { "label": "Low",       "value": 4, "segments": [{ "name": "Not Started", "value": 2 }, { "name": "In progress", "value": 1 }, { "name": "Completed", "value": 1 }] }
            ],
            "legend": [
              { "label": "Not started", "value": "9",  "color": "#A6A6A6" },
              { "label": "In progress", "value": "8",  "color": "#5B5FC7" },
              { "label": "Late",        "value": "2",  "color": "#D13438" },
              { "label": "Completed",   "value": "1",  "color": "#3FB984" }
            ]
          },
          {
            "title": "Status by bucket",
            "type": "bar",
            "bars": [
              { "label": "No bucket",   "value": 6, "segments": [{ "name": "Not Started", "value": 4 }, { "name": "In progress", "value": 2 }] },
              { "label": "In progress", "value": 8, "segments": [{ "name": "Not Started", "value": 3 }, { "name": "In progress", "value": 4 }, { "name": "Late", "value": 1 }] },
              { "label": "Done",        "value": 4, "segments": [{ "name": "Completed", "value": 4 }] }
            ],
            "legend": [
              { "label": "Not started", "value": "7",  "color": "#A6A6A6" },
              { "label": "In progress", "value": "6",  "color": "#5B5FC7" },
              { "label": "Late",        "value": "1",  "color": "#D13438" },
              { "label": "Completed",   "value": "4",  "color": "#3FB984" }
            ]
          },
          {
            "title": "Status by members",
            "type": "bar",
            "bars": [
              { "label": "Priya Singh", "value": 4, "segments": [{ "name": "Not Started", "value": 2 }, { "name": "In progress", "value": 1 }, { "name": "Completed", "value": 1 }] },
              { "label": "Marco Costa", "value": 3, "segments": [{ "name": "Not Started", "value": 1 }, { "name": "In progress", "value": 2 }] },
              { "label": "Hannah Ito",  "value": 4, "segments": [{ "name": "Not Started", "value": 1 }, { "name": "In progress", "value": 2 }, { "name": "Completed", "value": 1 }] },
              { "label": "Owen Tanaka", "value": 2, "segments": [{ "name": "Not Started", "value": 1 }, { "name": "In progress", "value": 1 }] }
            ],
            "legend": [
              { "label": "Not started", "value": "5",  "color": "#A6A6A6" },
              { "label": "In progress", "value": "6",  "color": "#5B5FC7" },
              { "label": "Completed",   "value": "2",  "color": "#3FB984" }
            ]
          }
        ]
      }
    }
  ]
}
