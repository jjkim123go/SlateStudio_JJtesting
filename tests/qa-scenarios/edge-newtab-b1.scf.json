dden;}.b1e-nt-card-source{font-size:11px;color:#888;margin-top:6px;}.b1e-nt-weather{display:flex;align-items:center;gap:8px;position:absolute;top:16px;right:24px;font-size:12px;color:#555;}</style><div class=\"b1e-page\"><div class=\"b1e-nt\" style=\"position:relative;\"><div class=\"b1e-nt-weather\">☁️ Redmond, WA &middot; 62°F</div><div class=\"b1e-nt-greeting\">Good afternoon, Alex</div><div class=\"b1e-nt-search\"><svg viewBox=\"0 0 20 20\"><circle cx=\"8.5\" cy=\"8.5\" r=\"5.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"/><path d=\"M12.5 12.5l4 4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\"/></svg><span class=\"b1e-nt-search-text\">Search the web</span></div><div class=\"b1e-nt-sites\"><div class=\"b1e-nt-site\"><div class=\"b1e-nt-site-icon\"><svg viewBox=\"0 0 24 24\"><rect width=\"24\" height=\"24\" rx=\"4\" fill=\"#0078D4\"/><text x=\"7\" y=\"17\" font-family=\"Segoe UI,sans-serif\" font-size=\"13\" font-weight=\"600\" fill=\"#fff\">O</text></svg></div><span class=\"b1e-nt-site-label\">Outlook</span></div><div class=\"b1e-nt-site\"><div class=\"b1e-nt-site-icon\"><svg viewBox=\"0 0 24 24\"><rect width=\"24\" height=\"24\" rx=\"4\" fill=\"#6264A7\"/><text x=\"7\" y=\"17\" font-family=\"Segoe UI,sans-serif\" font-size=\"13\" font-weight=\"600\" fill=\"#fff\">T</text></svg></div><span class=\"b1e-nt-site-label\">Teams</span></div><div class=\"b1e-nt-site\"><div class=\"b1e-nt-site-icon\"><svg viewBox=\"0 0 24 24\"><rect width=\"24\" height=\"24\" rx=\"4\" fill=\"#0078D4\"/><text x=\"7\" y=\"17\" font-family=\"Segoe UI,sans-serif\" font-size=\"13\" font-weight=\"600\" fill=\"#fff\">O</text></svg></div><span class=\"b1e-nt-site-label\">OneDrive</span></div><div class=\"b1e-nt-site\"><div class=\"b1e-nt-site-icon\"><svg viewBox=\"0 0 24 24\"><rect width=\"24\" height=\"24\" rx=\"4\" fill=\"#24292f\"/><text x=\"7\" y=\"17\" font-family=\"Segoe UI,sans-serif\" font-size=\"13\" font-weight=\"600\" fill=\"#fff\