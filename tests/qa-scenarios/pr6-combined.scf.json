        "options": [
          { "id": "opt-post",   "label": "POST",   "explanation": "POST creates new resources — repeating creates duplicates." },
          { "id": "opt-put",    "label": "PUT",    "explanation": "Correct — PUT replaces, so repeating is safe." },
          { "id": "opt-patch",  "label": "PATCH",  "explanation": "PATCH is not guaranteed idempotent by spec." }
