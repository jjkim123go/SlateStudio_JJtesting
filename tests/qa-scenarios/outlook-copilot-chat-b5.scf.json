        "toastState": "hidden",
        "viewBodyHtml": "<style>\n.b5c-root{position:relative;display:flex;flex:1 1 auto;min-width:0;min-height:0;background:#faf9f8;font-family:'Segoe UI Variable',-apple-system,Segoe UI,sans-serif;color:#242424;}\n.b5c-folders{width:240px;flex:0 0 240px;background:#f3f2f1;border-right:1px solid #e1dfdd;padding:14px 8px;font-size:13px;overflow:hidden;}\n.b5c-folders-h{font-size:11px;font-weight:600;color:#605e5c;text-transform:uppercase;letter-spacing:.4px;padding:6px 10px;}\n.b5c-fold{display:flex;align-items:center;gap:10px;padding:6px 10px;border-radius:4px;color:#323130;}\n.b5c-fold .ic{width:16px;height:16px;color:#605e5c;}\n.b5c-fold .ct{margin-left:auto;color:#605e5c;font-size:12px;}\n.b5c-fold.act{background:#e1dfdd;font-weight:600;color:#0f6cbd;}\n.b5c-fold.act .ic{color:#0f6cbd;}\n.b5c-list{width:380px;flex:0 0 380px;background:#fff;border-right:1px solid #edebe9;display:flex;flex-direction:column;}\n.b5c-list-head{display:flex;align-items:center;justify-content:space-between;padding:12px 16px 8px;}\n.b5c-list-title{font-size:18px;font-weight:600;}\n.b5c-list-tabs{display:flex;gap:18px;padding:0 16px;border-bottom:1px solid #edebe9;font-size:13px;color:#605e5c;}\n.b5c-list-tab{padding:6px 0 8px;}\n.b5c-list-tab.act{color:#242424;font-weight:600;border-bottom:2px solid #0f6cbd;}\n.b5c-msg{display:flex;gap:10px;padding:10px 16px;border-bottom:1px solid #f3f2f1;cursor:default;}\n.b5c-msg.unread{background:#fff;}\n.b5c-msg.sel{background:#edebe9;border-left:3px solid #0f6cbd;padding-left:13px;}\n.b5c-av{width:32px;height:32px;border-radius:50%;background:#0f6cbd;color:#fff;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:600;flex:0 0 32px;}\n.b5c-av.g2{background:#8764b8;}.b5c-av.g3{background:#038387;}.b5c-av.g4{background:#ca5010;}.b5c-av.g5{background:#5c2e91;}\n.b5c-msg-body{flex:1;min-width:0;}\n.b5c-msg-from{display:flex;justify-content:space-between;font-size:13px;font-weight:600;color:#242424;}\n.b5c-msg.unread .b5c-msg-from{color:#0f6cbd;}\n.b5c-msg-time{font-weight:400;color:#605e5c;font-size:11px;}\n.b5c-msg-subj{font-size:13px;color:#242424;margin-top:1px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}\n.b5c-msg-prev{font-size:12px;color:#605e5c;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;margin-top:1px;}\n.b5c-read{flex:1;min-width:0;background:#fff;padding:24px 32px;overflow:hidden;}\n.b5c-read-subj{font-size:20px;font-weight:600;color:#242424;}\n.b5c-read-meta{display:flex;gap:10px;align-items:center;margin-top:14px;padding-bottom:14px;border-bottom:1px solid #edebe9;}\n.b5c-read-meta .b5c-av{width:36px;height:36px;}\n.b5c-read-from{font-size:13px;font-weight:600;}\n.b5c-read-to{font-size:12px;color:#605e5c;}\n.b5c-read-body{font-size:14px;line-height:1.55;color:#323130;margin-top:18px;max-width:560px;}\n.b5c-read-body p{margin:0 0 12px;}\n\n/* ===== Copilot pane overlay ===== */\n.b5c-pane{position:absolute;top:0;right:0;bottom:0;width:360px;background:#fff;border-left:1px solid #e1dfdd;box-shadow:-4px 0 12px rgba(0,0,0,.06);display:flex;flex-direction:column;z-index:5;}\n.b5c-pane-head{display:flex;align-items:center;gap:8px;padding:12px 14px;border-bottom:1px solid #edebe9;}\n.b5c-pane-spark{width:20px;height:20px;}\n.b5c-pane-title{font-size:15px;font-weight:600;color:#242424;}\n.b5c-pane-tabs{display:flex;gap:4px;background:#f3f2f1;border-radius:14px;padding:2px;margin-left:8px;}\n.b5c-pane-tab{font-size:12px;padding:4px 12px;border-radius:12px;color:#605e5c;}\n.b5c-pane-tab.act{background:#fff;color:#242424;font-weight:600;box-shadow:0 1px 2px rgba(0,0,0,.08);}\n.b5c-pane-x{margin-left:auto;width:24px;height:24px;color:#605e5c;display:flex;align-items:center;justify-content:center;}\n.b5c-pane-body{flex:1;overflow:hidden;display:flex;flex-direction:column;}\n.b5c-pane-conv{flex:1;padding:14px;overflow:hidden;}\n.b5c-turn-user{display:flex;justify-content:flex-end;margin-bottom:14px;}\n.b5c-bub-user{background:#deecf9;color:#1a3a5c;font-size:13px;line-height:1.45;padding:9px 12px;border-radius:14px 14px 4px 14px;max-width:260px;}\n.b5c-turn-asst{display:flex;gap:8px;margin-bottom:18px;}\n.b5c-asst-spark{width:24px;height:24px;flex:0 0 24px;border-radius:50%;background:linear-gradient(135deg,#9168f0,#0f6cbd);display:flex;align-items:center;justify-content:center;color:#fff;}\n.b5c-asst-spark svg{width:14px;height:14px;}\n.b5c-bub-asst{font-size:13px;line-height:1.5;color:#242424;flex:1;min-width:0;}\n.b5c-bub-asst .src{display:inline-flex;align-items:center;gap:4px;font-size:11px;color:#0f6cbd;background:#deecf9;padding:1px 6px;border-radius:8px;margin:0 1px;text-decoration:none;}\n.b5c-sugs{display:flex;flex-wrap:wrap;gap:6px;padding:0 14px 10px;}\n.b5c-sug{display:flex;align-items:center;gap:6px;font-size:12px;color:#242424;background:#fff;border:1px solid #e1dfdd;padding:6px 10px;border-radius:14px;}\n.b5c-sug svg{width:13px;height:13px;color:#0f6cbd;}\n.b5c-input-wrap{padding:8px 14px 14px;border-top:1px solid #edebe9;background:#fff;}\n.b5c-input{display:flex;align-items:center;gap:8px;background:#f3f2f1;border:1px solid #e1dfdd;border-radius:18px;padding:8px 10px;}\n.b5c-input-ph{flex:1;font-size:13px;color:#a19f9d;}\n.b5c-input-ic{width:18px;height:18px;color:#605e5c;}\n.b5c-input-send{width:24px;height:24px;border-radius:50%;background:#0f6cbd;color:#fff;display:flex;align-items:center;justify-content:center;}\n.b5c-input-send svg{width:14px;height:14px;}\n.b5c-mode{font-size:11px;color:#605e5c;text-align:center;margin-top:6px;}\n</style>\n<div class=\"b5c-root\">\n  <aside class=\"b5c-folders\">\n    <div class=\"b5c-folders-h\">Favorites</div>\n    <div class=\"b5c-fold act\"><svg class=\"ic\" viewBox=\"0 0 16 16\" fill=\"none\"><path d=\"M2 4h12v8H2z\" stroke=\"currentColor\" stroke-width=\"1.2\"/><path d=\"M2 4l6 5 6-5\" stroke=\"currentColor\" stroke-width=\"1.2\"/></svg><span>Inbox</span><span class=\"ct\">12</span></div>\n    <div class=\"b5c-fold\"><svg class=\"ic\" viewBox=\"0 0 16 16\" fill=\"none\"><path d=\"M3 3h7l3 3v7H3z\" stroke=\"currentColor\" stroke-width=\"1.2\"/></svg><span>Drafts</span><span class=\"ct\">3</span></div>\n    <div class=\"b5c-fold\"><svg class=\"ic\" viewBox=\"0 0 16 16\" fill=\"none\"><path d=\"M2 8l12-5-4 12-3-5z\" stroke=\"currentColor\" stroke-width=\"1.2\" stroke-linejoin=\"round\"/></svg><span>Sent Items</span></div>\n    <div class=\"b5c-fold\"><svg class=\"ic\" viewBox=\"0 0 16 16\" fill=\"none\"><path d=\"M3 5h10l-1 8H4z\" stroke=\"currentColor\" stroke-width=\"1.2\"/><path d=\"M6 5V3h4v2\" stroke=\"currentColor\" stroke-width=\"1.2\"/></svg><span>Deleted Items</span></div>\n    <div class=\"b5c-folders-h\" style=\"margin-top:12px\">Folders</div>\n    <div class=\"b5c-fold\"><svg class=\"ic\" viewBox=\"0 0 16 16\" fill=\"none\"><path d=\"M2 4h12v8H2z\" stroke=\"currentColor\" stroke-width=\"1.2\"/><path d=\"M2 4l6 5 6-5\" stroke=\"currentColor\" stroke-width=\"1.2\"/></svg><span>Inbox</span></div>\n    <div class=\"b5c-fold\"><svg class=\"ic\" viewBox=\"0 0 16 16\" fill=\"none\"><rect x=\"2\" y=\"3\" width=\"12\" height=\"10\" stroke=\"currentColor\" stroke-width=\"1.2\"/></svg><span>Archive</span></div>\n    <div class=\"b5c-fold\"><svg class=\"ic\" viewBox=\"0 0 16 16\" fill=\"none\"><path d=\"M3 4h10v9H3z\" stroke=\"currentColor\" stroke-width=\"1.2\"/><path d=\"M5 7h6M5 9h4\" stroke=\"currentColor\" stroke-width=\"1.2\"/></svg><span>Notes</span><span class=\"ct\">2</span></div>\n  </aside>\n\n  <section class=\"b5c-list\">\n    <div class=\"b5c-list-head\">\n      <div class=\"b5c-list-title\">Inbox</div>\n      <div style=\"font-size:12px;color:#605e5c\">Filter</div>\n    </div>\n    <div class=\"b5c-list-tabs\"><div class=\"b5c-list-tab act\">Focused</div><div class=\"b5c-list-tab\">Other</div></div>\n    <div class=\"b5c-msg unread sel\">\n      <div class=\"b5c-av\">JP</div>\n      <div class=\"b5c-msg-body\">\n        <div class=\"b5c-msg-from\">Jordan Park<span class=\"b5c-msg-time\">9:42 AM</span></div>\n        <div class=\"b5c-msg-subj\">Q4 roadmap review — agenda</div>\n        <div class=\"b5c-msg-prev\">Hi team, attaching the draft agenda for Thursday's review. Please add…</div>\n      </div>\n    </div>\n    <div class=\"b5c-msg unread\">\n      <div class=\"b5c-av g2\">SR</div>\n      <div class=\"b5c-msg-body\">\n        <div class=\"b5c-msg-from\">Sam Rivera<span class=\"b5c-msg-time\">9:18 AM</span></div>\n        <div class=\"b5c-msg-subj\">Design critique notes</div>\n        <div class=\"b5c-msg-prev\">Quick recap from yesterday — three changes to the onboarding flow…</div>\n      </div>\n    </div>\n    <div class=\"b5c-msg unread\">\n      <div class=\"b5c-av g3\">MS</div>\n      <div class=\"b5c-msg-body\">\n        <div class=\"b5c-msg-from\">Morgan Singh<span class=\"b5c-msg-time\">8:55 AM</span></div>\n        <div class=\"b5c-msg-subj\">Eng all-hands prep</div>\n        <div class=\"b5c-msg-prev\">Slides are in OneDrive — can you do a pass before noon?</div>\n      </div>\n    </div>\n    <div class=\"b5c-msg\">\n      <div class=\"b5c-av g4\">CL</div>\n      <div class=\"b5c-msg-body\">\n        <div class=\"b5c-msg-from\">Casey Lee<span class=\"b5c-msg-time\">Yesterday</span></div>\n        <div class=\"b5c-msg-subj\">Re: Architecture sync</div>\n        <div class=\"b5c-msg-prev\">Thanks for the writeup. One question on the cache invalidation pattern…</div>\n      </div>\n    </div>\n    <div class=\"b5c-msg\">\n      <div class=\"b5c-av g5\">RB</div>\n      <div class=\"b5c-msg-body\">\n        <div class=\"b5c-msg-from\">Riley Brooks<span class=\"b5c-msg-time\">Yesterday</span></div>\n        <div class=\"b5c-msg-subj\">Vendor onboarding checklist</div>\n        <div class=\"b5c-msg-prev\">Sharing the updated checklist with new sections for security review…</div>\n      </div>\n    </div>\n    <div class=\"b5c-msg\">\n      <div class=\"b5c-av\">DP</div>\n      <div class=\"b5c-msg-body\">\n        <div class=\"b5c-msg-from\">Drew Patel<span class=\"b5c-msg-time\">Mon</span></div>\n        <div class=\"b5c-msg-subj\">Budget tracker — November update</div>\n        <div class=\"b5c-msg-prev\">November numbers are in. We're tracking 4% under plan on infra spend…</div>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"b5c-read\">\n    <div class=\"b5c-read-subj\">Q4 roadmap review — agenda</div>\n    <div class=\"b5c-read-meta\">\n      <div class=\"b5c-av\">JP</div>\n      <div>\n        <div class=\"b5c-read-from\">Jordan Park &lt;jordan.park@contoso.com&gt;</div>\n        <div class=\"b5c-read-to\">To: Alex Chen, Sam Rivera · 9:42 AM</div>\n      </div>\n    </div>\n    <div class=\"b5c-read-body\">\n      <p>Hi team,</p>\n      <p>Attaching the draft agenda for Thursday's Q4 roadmap review. Please add any topics you'd like covered by end of day Wednesday.</p>\n      <p>Key sections so far: roadmap rollup, capacity planning, Q1 prelim themes, and open risks.</p>\n      <p>Thanks,<br/>Jordan</p>\n    </div>\n  </section>\n\n  <!-- ===== Copilot side pane (overlay) ===== -->\n  <aside class=\"b5c-pane\" aria-label=\"Copilot chat\">\n    <div class=\"b5c-pane-head\">\n      <svg class=\"b5c-pane-spark\" viewBox=\"0 0 20 20\" fill=\"none\"><defs><linearGradient id=\"b5cg1\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\"><stop offset=\"0\" stop-color=\"#9168f0\"/><stop offset=\"1\" stop-color=\"#0f6cbd\"/></linearGradient></defs><path fill=\"url(#b5cg1)\" d=\"M10 2l1.6 4.4L16 8l-4.4 1.6L10 14l-1.6-4.4L4 8l4.4-1.6zM15 13l.7 1.8L17.5 15.5l-1.8.7L15 18l-.7-1.8L12.5 15.5l1.8-.7z\"/></svg>\n      <span class=\"b5c-pane-title\">Copilot</span>\n      <div class=\"b5c-pane-tabs\"><div class=\"b5c-pane-tab act\">Chat</div><div class=\"b5c-pane-tab\">Pages</div></div>\n      <div class=\"b5c-pane-x\"><svg viewBox=\"0 0 16 16\" fill=\"none\"><path d=\"M4 4l8 8M12 4l-8 8\" stroke=\"currentColor\" stroke-width=\"1.2\"/></svg></div>\n    </div>\n    <div class=\"b5c-pane-body\">\n      <div class=\"b5c-pane-conv\">\n        <div class=\"b5c-turn-user\">\n          <div class=\"b5c-bub-user\">Summarize my unread emails from this morning</div>\n        </div>\n        <div class=\"b5c-turn-asst\">\n          <div class=\"b5c-asst-spark\"><svg viewBox=\"0 0 16 16\" fill=\"currentColor\"><path d=\"M8 1l1.4 3.6L13 6l-3.6 1.4L8 11 6.6 7.4 3 6l3.6-1.4z\"/></svg></div>\n          <div class=\"b5c-bub-asst\">You have 3 unread messages this morning. <a class=\"src\">Jordan Park</a> shared the Q4 roadmap review agenda for Thursday and is asking for topic additions by Wednesday. <a class=\"src\">Sam Rivera</a> sent design critique notes with three onboarding flow changes. <a class=\"src\">Morgan Singh</a> needs an eng all-hands slide review before noon.</div>\n        </div>\n        <div class=\"b5c-turn-user\">\n          <div class=\"b5c-bub-user\">Draft a reply to Jordan accepting the meeting</div>\n        </div>\n        <div class=\"b5c-turn-asst\">\n          <div class=\"b5c-asst-spark\"><svg viewBox=\"0 0 16 16\" fill=\"currentColor\"><path d=\"M8 1l1.4 3.6L13 6l-3.6 1.4L8 11 6.6 7.4 3 6l3.6-1.4z\"/></svg></div>\n          <div class=\"b5c-bub-asst\">Here's a draft reply: \"Thanks Jordan — agenda looks solid. I'll add a bullet on the data-platform migration risks tonight. See you Thursday.\" Want me to insert it into a reply?</div>\n        </div>\n      </div>\n      <div class=\"b5c-sugs\">\n        <div class=\"b5c-sug\"><svg viewBox=\"0 0 16 16\" fill=\"currentColor\"><path d=\"M8 1l1.4 3.6L13 6l-3.6 1.4L8 11 6.6 7.4 3 6l3.6-1.4z\"/></svg>Find emails from Sam</div>\n        <div class=\"b5c-sug\"><svg viewBox=\"0 0 16 16\" fill=\"currentColor\"><path d=\"M8 1l1.4 3.6L13 6l-3.6 1.4L8 11 6.6 7.4 3 6l3.6-1.4z\"/></svg>What's on my calendar today?</div>\n        <div class=\"b5c-sug\"><svg viewBox=\"0 0 16 16\" fill=\"currentColor\"><path d=\"M8 1l1.4 3.6L13 6l-3.6 1.4L8 11 6.6 7.4 3 6l3.6-1.4z\"/></svg>Catch me up on roadmap thread</div>\n      </div>\n      <div class=\"b5c-input-wrap\">\n        <div class=\"b5c-input\">\n          <svg class=\"b5c-input-ic\" viewBox=\"0 0 16 16\" fill=\"none\"><path d=\"M8 3v10M3 8h10\" stroke=\"currentColor\" stroke-width=\"1.3\"/></svg>\n          <span class=\"b5c-input-ph\">Message Copilot</span>\n          <svg class=\"b5c-input-ic\" viewBox=\"0 0 16 16\" fill=\"none\"><rect x=\"6\" y=\"2\" width=\"4\" height=\"8\" rx=\"2\" stroke=\"currentColor\" stroke-width=\"1.3\"/><path d=\"M4 8a4 4 0 008 0M8 12v2\" stroke=\"currentColor\" stroke-width=\"1.3\"/></svg>\n          <div class=\"b5c-input-send\"><svg viewBox=\"0 0 16 16\" fill=\"none\"><path d=\"M3 8l10-5-3 12-3-5z\" stroke=\"currentColor\" stroke-width=\"1.3\" stroke-linejoin=\"round\"/></svg></div>\n        </div>\n        <div class=\"b5c-mode\">Default mode · Work</div>\n      </div>\n    </div>\n  </aside>\n</div>"
      }
