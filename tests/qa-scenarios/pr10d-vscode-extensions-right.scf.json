        "tabListHtml": "<div class=\"vs-tab\"><span class=\"vs-tab-icon\"><svg width=\"16\" height=\"16\" aria-hidden=\"true\"><use href=\"#vscode-icon-file-json\"/></svg></span><span class=\"vs-tab-label\">package.json</span><button class=\"vs-tab-close\" aria-label=\"Close\"><svg width=\"16\" height=\"16\" aria-hidden=\"true\"><use href=\"#vscode-icon-close\"/></svg></button></div><div class=\"vs-tab vs-tab--active\"><span class=\"vs-tab-icon\"><svg width=\"16\" height=\"16\" aria-hidden=\"true\"><use href=\"#vscode-icon-file-ts\"/></svg></span><span class=\"vs-tab-label\">app.ts</span><button class=\"vs-tab-close\" aria-label=\"Close\"><svg width=\"16\" height=\"16\" aria-hidden=\"true\"><use href=\"#vscode-icon-close\"/></svg></button></div><div class=\"vs-tab\"><span class=\"vs-tab-icon\"><svg width=\"16\" height=\"16\" aria-hidden=\"true\"><use href=\"#vscode-icon-file-md\"/></svg></span><span class=\"vs-tab-label\">README.md</span><button class=\"vs-tab-close\" aria-label=\"Close\"><svg width=\"16\" height=\"16\" aria-hidden=\"true\"><use href=\"#vscode-icon-close\"/></svg></button></div>",
