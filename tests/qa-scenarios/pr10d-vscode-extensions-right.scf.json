        "gutterHtml": "<span class=\"vs-gutter-line\">1</span><span class=\"vs-gutter-line\">2</span><span class=\"vs-gutter-line\">3</span><span class=\"vs-gutter-line\">4</span><span class=\"vs-gutter-line\">5</span><span class=\"vs-gutter-line\">6</span><span class=\"vs-gutter-line\">7</span><span class=\"vs-gutter-line\">8</span><span class=\"vs-gutter-line\">9</span><span class=\"vs-gutter-line\">10</span><span class=\"vs-gutter-line\">11</span><span class=\"vs-gutter-line\">12</span><span class=\"vs-gutter-line\">13</span>",
        "codeContentHtml": "<span class=\"vs-code-line\"><span class=\"vs-tk-com\">// Application entry point</span></span><span class=\"vs-code-line\"><span class=\"vs-tk-kw\">import</span> { <span class=\"vs-tk-var\">createServer</span> } <span class=\"vs-tk-kw\">from</span> <span class=\"vs-tk-str\">'./server'</span>;</span><span class=\"vs-code-line\"><span class=\"vs-tk-kw\">import</span> { <span class=\"vs-tk-var\">AuthService</span> } <span class=\"vs-tk-kw\">from</span> <span class=\"vs-tk-str\">'./auth/auth'</span>;</span><span class=\"vs-code-line\"><span class=\"vs-tk-kw\">import</span> { <span class=\"vs-tk-var\">config</span> } <span class=\"vs-tk-kw\">from</span> <span class=\"vs-tk-str\">'./config'</span>;</span><span class=\"vs-code-line\"></span><span class=\"vs-code-line\"><span class=\"vs-tk-kw\">const</span> <span class=\"vs-tk-var\">auth</span> = <span class=\"vs-tk-kw\">new</span> <span class=\"vs-tk-type\">AuthService</span>(<span class=\"vs-tk-var\">config</span>.<span class=\"vs-tk-prop\">jwtSecret</span>);</span><span class=\"vs-code-line\"><span class=\"vs-tk-kw\">const</span> <span class=\"vs-tk-var\">app</span> = <span class=\"vs-tk-fn\">createServer</span>({ <span class=\"vs-tk-prop\">auth</span> });</span><span class=\"vs-code-line\"></span><span class=\"vs-code-line\"><span class=\"vs-tk-var\">app</span>.<span class=\"vs-tk-fn\">listen</span>(<span class=\"vs-tk-var\">config</span>.<span class=\"vs-tk-prop\">port</span>, () =&gt; {</span><span class=\"vs-code-line\">  <span class=\"vs-tk-var\">console</span>.<span class=\"vs-tk-fn\">log</span>(<span class=\"vs-tk-str\">`Server running on :${config.port}`</span>);</span><span class=\"vs-code-line\">});</span><span class=\"vs-code-line\"></span><span class=\"vs-code-line\"><span class=\"vs-tk-kw\">export</span> { <span class=\"vs-tk-var\">app</span> };</span>",
